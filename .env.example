NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mock/실제 API 전환: "false"로 설정하면 로그인 상태에서 실제 API를 호출한다.
# 비로그인·둘러보기는 이 값과 무관하게 정적 샘플(Mock)만 조회한다(F-106).
NEXT_PUBLIC_USE_MOCK=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
CRON_SECRET=
# 데이터 수집은 GTM 태그가 담당한다(F-901 / I-719).
# 컨테이너 ID 는 공개값이므로 NEXT_PUBLIC_ 을 붙인다. 값은 저장소에 기록하지 않는다.
# 비어 있으면 GTM 을 로드하지 않아 수집 자체가 발생하지 않는다(비활성 기본값).
NEXT_PUBLIC_GTM_ID=
# GA4 측정 ID (증빙 자료 제출용). 앱 코드는 직접 쓰지 않고 GTM 태그 설정에서 쓴다.
NEXT_PUBLIC_GA4_ID=
