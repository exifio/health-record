NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mock/실제 API 전환: "false"로 설정하면 로그인 상태에서 실제 API를 호출한다.
# 비로그인·둘러보기는 이 값과 무관하게 정적 샘플(Mock)만 조회한다(F-106).
NEXT_PUBLIC_USE_MOCK=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
CRON_SECRET=
# Amplitude 제품 분석용 공개 API key(F-901). 비어 있으면 이벤트를 보내지 않는다.
# 공개 key이므로 저장소에 커밋하지 않는다. 개인 식별자·건강 원문은 보내지 않는다(SECURITY.md 6절).
NEXT_PUBLIC_AMPLITUDE_API_KEY=
